{
    "name": "samjuk/m2-module-auto-login-admin",
    "description": "Automatically logins into the Admin panel, to a preset user",
    "type": "magento2-module",
    "require": {
        "php": "^8.1",
        "magento/framework": "^103.0",
        "magento/module-backend": "^102.0",
        "magento/module-user": "^101.2",
        "magento/module-config": "^101.2"
    },
    "license": [
        "MIT"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "SamJUK\\AutoLoginAdmin\\": ""
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "samjuk/dev-standards": "^1.0",
        "magento/magento-coding-standard": "^41.0",
        "bitexpert/phpstan-magento": "^0.44.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3"
    },
    "homepage": "https://github.com/SamJUK/m2-module-auto-login-admin",
    "authors": [
        {
            "name": "Sam James",
            "email": "sam@samdjames.uk",
            "homepage": "https://www.samdjames.uk"
        }
    ],
    "keywords": [
        "magento2",
        "magento 2",
        "magento2-module",
        "adobe-commerce",
        "extension",
        "admin",
        "auto-login",
        "local-development",
        "devtools",
        "open-source"
    ],
    "repositories": [{
        "name": "mage-os",
        "type": "composer",
        "url": "https://mirror.mage-os.org/"
    }],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "magento/composer-dependency-version-audit-plugin": false,
            "magento/magento-composer-installer": false,
            "phpstan/extension-installer": true
        }
    }
}
